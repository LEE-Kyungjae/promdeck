{
  "promUrl": "http://127.0.0.1:9090",
  "refreshSec": 15,
  "brightness": 60,
  "buttons": [
    {
      "key": 0,
      "title": "OUTAGE",
      "query": "count(probe_success == 0) or vector(0)",
      "decimals": 0,
      "warn": 1,
      "crit": 1,
      "sparkRange": "6h"
    },
    {
      "key": 1,
      "title": "cert",
      "query": "min((probe_ssl_earliest_cert_expiry - time()) / 86400)",
      "unit": "d",
      "decimals": 0,
      "warn": 14,
      "crit": 5,
      "invert": true,
      "sparkRange": "24h"
    },
    {
      "key": 2,
      "title": "scrape",
      "query": "count(up == 0) or vector(0)",
      "decimals": 0,
      "warn": 1,
      "sparkRange": "6h"
    },

    {
      "key": 8,
      "title": "www",
      "query": "probe_duration_seconds{instance=\"https://example.com\"} * 1000",
      "healthQuery": "probe_success{instance=\"https://example.com\"}",
      "unit": "ms",
      "decimals": 0,
      "warn": 1500,
      "crit": 3000,
      "sparkRange": "2h"
    },

    {
      "key": 16,
      "title": "mem",
      "query": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
      "unit": "%",
      "decimals": 1,
      "warn": 88,
      "crit": 94,
      "sparkRange": "2h"
    },
    {
      "key": 17,
      "title": "cpu",
      "query": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
      "unit": "%",
      "decimals": 0,
      "warn": 70,
      "crit": 90,
      "sparkRange": "2h"
    },
    {
      "key": 18,
      "title": "disk",
      "query": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
      "unit": "%",
      "decimals": 0,
      "warn": 75,
      "crit": 90,
      "sparkRange": "24h"
    },
    {
      "key": 19,
      "title": "load",
      "query": "node_load1",
      "decimals": 2,
      "warn": 4,
      "crit": 8,
      "sparkRange": "2h"
    }
  ]
}
