{
  "name": "promdeck",
  "version": "1.0.0",
  "description": "Put your Prometheus metrics on Stream Deck keys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LEE-Kyungjae/promdeck.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
